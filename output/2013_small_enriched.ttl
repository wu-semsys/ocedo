<https://w3id.org/semsys/ns/ocedo/core> a owl:Ontology ;
    dcterms:contributor "Claudio di Ciccio",
        "Maxim Vidgof",
        "Sabrina Kirrane" ;
    dcterms:created "2024-08-20" ;
    dcterms:creator "Fajar J. Ekaputra",
        "Saba Latif" ;
    dcterms:description """An ontology to describe Object-Centric Event Data (OCED) for Process Mining. \r
                                        The current name of class and property is based on the second version of OCED specification (published at BPM2024).\r
                                        Additionally, we add skos:altLabel for documenting the class/property label from the first version of OCED. \r
                                        The classes and properties are based on previous OCED meta-model(https://www.tf-pm.org/upload/1678694478319.pdf). \r
                                        But this ontology includes alt labels which reflect the new ontology version(https://arxiv.org/pdf/2410.14495)"""@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0> ;
    dcterms:modified "2024-08-20" ;
    dcterms:title "The OCED Ontology"@en ;
    vann:preferredNamespacePrefix "ocedo" ;
    vann:preferredNamespaceUri "https://w3id.org/semsys/ns/ocedo/core#" .

