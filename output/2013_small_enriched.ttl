@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ext: <https://w3id.org/ocedo/ext#> .
@prefix oced: <https://w3id.org/ocedo/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <https://w3id.org/ocedo/resource/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oced:object_relation a owl:ObjectProperty ;
    rdfs:label "observes" ;
    rdfs:comment "the super-property for all use-case specific relations between two Objects" ;
    rdfs:domain oced:Event ;
    rdfs:range xsd:Object .

oced:observed_at a owl:DatatypeProperty ;
    rdfs:label "observed_at" ;
    rdfs:comment "timestamp of an event" ;
    rdfs:domain oced:Event ;
    rdfs:range xsd:dateTime .

oced:observes a owl:ObjectProperty ;
    rdfs:label "observes" ;
    rdfs:comment "the super-property for all use-case specific relations Event and Object" ;
    rdfs:domain oced:Event ;
    rdfs:range xsd:Object .

ext:concept_name a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:event_attribute,
        oced:object_attribute .

ext:event_case a owl:ObjectProperty ;
    rdfs:label "ext:event_case" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:Case .

ext:handled_by_support_team a owl:ObjectProperty ;
    rdfs:label "ext:handled_by_support_team" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:SupportTeam .

ext:handled_by_team_member a owl:ObjectProperty ;
    rdfs:label "ext:handled_by_team_member" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:TeamMember .

ext:handled_in_service_center a owl:ObjectProperty ;
    rdfs:label "ext:handled_in_service_center" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:ServiceCenter .

ext:has_impact a owl:ObjectProperty ;
    rdfs:label "ext:has_impact" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:Impact .

ext:impact a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:is_about_function a owl:ObjectProperty ;
    rdfs:label "ext:is_about_function" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:ProductFunction .

ext:is_about_product a owl:ObjectProperty ;
    rdfs:label "ext:is_about_product" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:Product .

ext:lifecycle_transition a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:event_attribute .

ext:located_in a owl:ObjectProperty ;
    rdfs:label "ext:located_in" ;
    rdfs:domain ext:ServiceCenter,
        ext:TeamMember ;
    rdfs:range ext:Location .

ext:org_group a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:org_resource a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:org_role a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:organization_country a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:organization_involved a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:part_of a owl:ObjectProperty ;
    rdfs:label "ext:part_of" ;
    rdfs:domain ext:SupportTeam,
        ext:TeamMember ;
    rdfs:range ext:ServiceCenter,
        ext:SupportTeam .

ext:product a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:resource_country a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

