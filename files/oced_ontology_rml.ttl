@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix map: <http://mapping.example.com/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix oced: <https://w3id.org/ocedo/core#> .
@prefix aux: <https://w3id.org/ocedo/aux#> .
@prefix res: <https://w3id.org/ocedo/resource/> .

## Event
map:event rdf:type rr:TriplesMap ;
    rdfs:label "event map" ;
    rml:logicalSource [
        rml:iterator "$.events[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/event-{id}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:object oced:Event ;
    ] , [
        rr:predicate aux:instance_of ;
        rr:objectMap [
            rr:template "https://w3id.org/ocedo/resource/etype-{instance_of}" ;
            rr:termType rr:IRI ;
        ] ;
    ] , [
        rr:predicate oced:observed_at ;
        rr:objectMap [
            rml:reference "observed_at" ;
            rr:datatype xsd:dateTime ;
        ] ;
    ] .

## Event Type
map:event_type rdf:type rr:TriplesMap ;
    rdfs:label "event type" ;
    rml:logicalSource [
        rml:iterator "$.events[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/etype-{instance_of}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:object aux:EventType ;
    ] , [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rml:reference "instance_of" ;
            rr:datatype xsd:string ;
        ] ;
    ] .

## Event to EventAttribute
map:has_event_attribute rdf:type rr:TriplesMap ;
    rdfs:label "has event attribute" ;
    rml:logicalSource [
        rml:iterator "$.events[*].attributes[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/event-{id}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate aux:hasEventAttribute ;
        rr:objectMap [
            rr:template "https://w3id.org/ocedo/resource/ea-{value_of}-{event_attribute_value}" ;
            rr:termType rr:IRI ;
        ] ;
    ] .

## Event Attribute
map:event_attribute rdf:type rr:TriplesMap ;
    rdfs:label "event attribute" ;
    rml:logicalSource [
        rml:iterator "$.events[*].attributes[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/ea-{value_of}-{event_attribute_value}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [
            rr:constant aux:EventAttribute ;
        ] ;
    ] , [
        rr:predicate aux:event_attribute ;
        rr:objectMap [
            rml:reference "value_of" ;
            rr:datatype xsd:string ;
        ] ;
    ] , [
        rr:predicate aux:event_attribute_value ;
        rr:objectMap [
            rml:reference "event_attribute_value" ;
            rr:datatype xsd:string ;
        ] ;
    ] .

## Object Mapping
map:object rdf:type rr:TriplesMap ;
    rdfs:label "object map" ;
    rml:logicalSource [
        rml:iterator "$.objects[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/object-{id}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [
            rr:constant oced:Object ;
        ] ;
    ] , [
        rr:predicate aux:instance_of ;
        rr:objectMap [
            rr:template "https://w3id.org/ocedo/resource/otype-{instance_of_O}" ;
            rr:termType rr:IRI ;
        ] ;
    ] .

## Object Type
map:object_type rdf:type rr:TriplesMap ;
    rdfs:label "object type" ;
    rml:logicalSource [
        rml:iterator "$.objects[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/otype-{instance_of_O}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:object aux:ObjectType ;
    ] , [
        rr:predicate rdfs:label ;
        rr:objectMap [
            rml:reference "instance_of_O" ;
            rr:datatype xsd:string ;
        ] ;
    ] .

## Object to ObjectAttribute
map:object_to_object_attribute rdf:type rr:TriplesMap ;
    rdfs:label "object attribute" ;
    rml:logicalSource [
        rml:iterator "$.objects[*].attributes[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/object-{id}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate aux:hasObjectAttribute ;
        rr:objectMap [
            rr:template "https://w3id.org/ocedo/resource/oa-{value_of_O}-{object_attribute_value}" ;
            rr:termType rr:IRI ;
        ] ;
    ] .

## Object Attribute Mapping
map:object_attribute rdf:type rr:TriplesMap ;
    rdfs:label "object attribute" ;
    rml:logicalSource [
        rml:iterator "$.objects[*].attributes[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/oa-{value_of_O}-{object_attribute_value}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [
            rr:constant aux:ObjectAttribute ;
        ] ;
    ] , [
        rr:predicate aux:object_attribute ;
        rr:objectMap [
            rml:reference "value_of_O" ;
            rr:datatype xsd:string ;
        ] ;
    ] , [
        rr:predicate aux:object_attribute_value ;
        rr:objectMap [
            rml:reference "object_attribute_value" ;
            rr:datatype xsd:string ;
        ] ;
    ] .

## Observe
map:event_object rdf:type rr:TriplesMap ;
    rdfs:label "event object relation" ;
    rml:logicalSource [
        rml:iterator "$.event_object[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/observe-{eventID}-{objectID}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [
            rr:constant aux:Observe ;
        ] ;
    ] , [
        rr:predicate aux:qualifier ;
        rr:objectMap [
            rml:reference "qualifier" ;
            rr:datatype xsd:string ;
        ] ;
    ] , [
        rr:predicate aux:eo_object ;
        rr:objectMap [
            rr:template "https://w3id.org/ocedo/resource/object-{objectID}" ;
            rr:termType rr:IRI ;
        ] ;
    ] , [
        rr:predicate aux:eo_event ;
        rr:objectMap [
            rr:template "https://w3id.org/ocedo/resource/event-{eventID}" ;
            rr:termType rr:IRI ;
        ] ;
    ] .

## ObjectRelation
map:object_relation rdf:type rr:TriplesMap ;
    rdfs:label "object relation" ;
    rml:logicalSource [
        rml:iterator "$.object_object[*]" ;
        rml:referenceFormulation ql:JSONPath ;
        rdf:type rml:LogicalSource 
    ] ;
    rr:subjectMap [
        rr:template "https://w3id.org/ocedo/resource/or-{from}-{to}" 
    ] ;
    rr:predicateObjectMap [
        rr:predicate rdf:type ;
        rr:objectMap [
            rr:constant aux:ObjectRelation ;
        ] ;
    ] , [
        rr:predicate aux:relation_type ;
        rr:objectMap [
            rml:reference "relation_type" ;
            rr:datatype xsd:string ;
        ] ;
    ] , [
        rr:predicate aux:from ;
        rr:objectMap [
            rr:template "https://w3id.org/ocedo/resource/object-{from}" ;
            rr:termType rr:IRI ;
        ] ;
    ] , [
        rr:predicate aux:to ;
        rr:objectMap [
            rr:template "https://w3id.org/ocedo/resource/event-{to}" ;
            rr:termType rr:IRI ;
        ] ;
    ] .
