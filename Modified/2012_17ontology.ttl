@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ext: <https://w3id.org/ocedo/ext#> .
@prefix oced: <https://w3id.org/ocedo/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oced:object_relation a owl:ObjectProperty ;
    rdfs:label "observes" ;
    rdfs:comment "the super-property for all use-case specific relations between two Objects" ;
    rdfs:domain oced:Event ;
    rdfs:range xsd:Object .

oced:observed_at a owl:DatatypeProperty ;
    rdfs:label "observed_at" ;
    rdfs:comment "timestamp of an event" ;
    rdfs:domain oced:Event ;
    rdfs:range xsd:dateTime .

oced:observes a owl:ObjectProperty ;
    rdfs:label "observes" ;
    rdfs:comment "the super-property for all use-case specific relations Event and Object" ;
    rdfs:domain oced:Event ;
    rdfs:range xsd:Object .

ext:A_Accepted_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:A_Cancelled_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:A_Complete_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:A_Concept_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:A_Create_Application_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:A_Submitted_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:Accepted a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:ApplicationType a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:CreditScore a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:FirstWithdrawalAmount a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:LoanGoal a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:MonthlyCost a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:NumberOfTerms a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:O_Cancelled_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:O_Create_Offer_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:O_Created_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:O_Sent_\(mail_and_online\)_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:OfferID a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:OfferedAmount a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:RequestedAmount a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:Selected a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:W_Call_after_offers_ate_abort a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Call_after_offers_resume a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Call_after_offers_schedule a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Call_after_offers_start a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Call_after_offers_suspend a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Complete_application_complete a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Complete_application_resume a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Complete_application_schedule a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Complete_application_start a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Complete_application_suspend a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Handle_leads_schedule a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:W_Handle_leads_withdraw a owl:Class ;
    rdfs:subClassOf ext:EventBPIC2017 .

ext:associated_EventID a owl:ObjectProperty ;
    rdfs:label "ext:associated_EventID" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:EventID .

ext:association_eventID_to_EventOrigin a owl:ObjectProperty ;
    rdfs:label "ext:association_eventID_to_EventOrigin" ;
    rdfs:domain ext:EventID ;
    rdfs:range ext:EventOrigin .

ext:concept_name a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:event_attribute,
        oced:object_attribute .

ext:event_case a owl:ObjectProperty ;
    rdfs:label "ext:event_case" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:Case .

ext:event_description a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:event_logical_description a owl:ObjectProperty ;
    rdfs:label "ext:event_logical_description" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:Event_description .

ext:has_Action a owl:ObjectProperty ;
    rdfs:label "ext:has_Action" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:Action .

ext:has_Associated_action a owl:ObjectProperty ;
    rdfs:label "ext:has_Associated_action" ;
    rdfs:domain ext:EventID ;
    rdfs:range ext:Action .

ext:is_a_resource a owl:ObjectProperty ;
    rdfs:label "ext:is_a_resource" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:Resource .

ext:lifecycle_transition a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:event_attribute .

ext:org_resource a owl:datatypeProperty ;
    rdfs:subPropertyOf oced:object_attribute .

ext:origin_of_Event a owl:ObjectProperty ;
    rdfs:label "ext:origin_of_Event" ;
    rdfs:domain oced:Event ;
    rdfs:range ext:EventOrigin .

ext:part_of a owl:ObjectProperty ;
    rdfs:label "ext:part_of" ;
    rdfs:domain ext:OrgTeamMember ;
    rdfs:range ext:Case .

ext:requested_loan_amount_by_resource a owl:ObjectProperty ;
    rdfs:label "ext:requested_loan_amount_by_resource" ;
    rdfs:domain ext:Amount_Req ;
    rdfs:range ext:Resource .

<https://w3id.org/semsys/ns/ocedo/core> a owl:Ontology ;
    dcterms:contributor "Claudio di Ciccio",
        "Maxim Vidgof",
        "Sabrina Kirrane" ;
    dcterms:created "2024-08-20" ;
    dcterms:creator "Fajar J. Ekaputra",
        "Saba Latif" ;
    dcterms:description """\r
    An ontology to describe Object-Centric Event Data (OCED) for Process Mining. \r
    The ontology consists of \r
    (a) OCED core part (prefix "oced") - describing core classes and properties, and \r
    (b) OCED auxilary part (prefix "aux:") - describing additional context \r
        information that will be replaced by use-case specific classes and \r
        properties in the implementation\r
    """@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0> ;
    dcterms:modified "2025-03-18" ;
    dcterms:title "The OCED Ontology"@en ;
    vann:preferredNamespacePrefix "oced" ;
    vann:preferredNamespaceUri "https://w3id.org/semsys/ns/ocedo/core#" .

oced:Object a owl:Class ;
    rdfs:label "Object" ;
    rdfs:comment "Representation of the Object class/concept" .

ext:Amount_Req a owl:Class ;
    rdfs:subClassOf ext:ObjectBPIC2017 .

ext:Event_description a owl:Class ;
    rdfs:subClassOf ext:ObjectBPIC2017 .

ext:OrgTeamMember a owl:Class ;
    rdfs:subClassOf ext:ObjectBPIC2017 .

oced:event_attribute a owl:DatatypeProperty ;
    rdfs:label "event_attribute" ;
    rdfs:comment "the super-property for all use-case specific event attributes" ;
    rdfs:domain oced:Event ;
    rdfs:range xsd:string .

ext:Action a owl:Class,
        owl:datatypeProperty ;
    rdfs:subClassOf ext:ObjectBPIC2017 ;
    rdfs:subPropertyOf oced:object_attribute .

ext:Case a owl:Class ;
    rdfs:subClassOf ext:ObjectBPIC2017 .

ext:EventOrigin a owl:Class,
        owl:datatypeProperty ;
    rdfs:subClassOf ext:ObjectBPIC2017 ;
    rdfs:subPropertyOf oced:object_attribute .

ext:Resource a owl:Class ;
    rdfs:subClassOf ext:ObjectBPIC2017 .

ext:EventID a owl:Class,
        owl:datatypeProperty ;
    rdfs:subClassOf ext:ObjectBPIC2017 ;
    rdfs:subPropertyOf oced:object_attribute .

oced:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "Representation of the Event class/concept" .

oced:object_attribute a owl:DatatypeProperty ;
    rdfs:label "object_attribute" ;
    rdfs:comment "the super-property for all use-case specific object attributes" ;
    rdfs:domain oced:Object ;
    rdfs:range xsd:string .

